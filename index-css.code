body {

    font-size: small;
    font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;
    line-height: 1.6;
    color: rgb(20, 0, 77);
    background-color: rgb(192, 240, 255);
}



h1 {
    vertical-align: middle;
    display: inline-block;
    font-size: xx-large;
    font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
    line-height: normal;
    color: rgb(2, 118, 0);

}

nav {
    display: inline-block;
    margin-left: 100px;
}

h4 {
    font-size: large;
    font-family: Arial, Helvetica, sans-serif;
    color: rgb(85, 47, 0);

}

img {
    vertical-align: middle;
}

a {
    vertical-align: middle;
    font-size: small;
    color: rgb(210, 0, 168);
    text-decoration: none;
}

ul {
    display: flex;
    list-style: none;
    padding: 30px;
    gap: 20px;
}

footer {
    text-align: center;
    color: rgb(150, 0, 0);
    font-size: small;

}
