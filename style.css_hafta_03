* {
    box-sizing: border-box;
}

:root {
    --ana-renk: #5d242f;
    --ust-renk: #d8ddab;
    --baglanti-renk: #5d242f;
    --zemin: #001e4a;
    --metin: #dfedff;
    --footer-renk: #30c220;
    --baslik-renk: #d09292;
}


body {

    font-size: small;
    font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;
    line-height: 1.6;
    color: var(--metin);
    background-color: var(--zemin);
    margin: 0;
}

.ust-menu {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0px 60px;
    background-color: var(--ust-renk);
}

/* Sol ve sağ blokların eşit esneklikte olması orta menüyü tam merkeze sabitler */
.sol-kisim {
    list-style: none;
    flex: 1;
    display: flex;
    align-items: center;
    transition: color 0.2s ease;

}

.sol-kisim a:hover {
    color: #62bbff;
}

.orta-kisim {
    list-style: none;
    /* Liste işaretlerini kaldırır */
    display: flex;
    gap: 150px;
    transition: color 0.2s ease;
}

.orta-kisim a:hover {
    color: #62bbff;
}


.isim {
    font-size: 15px;
}



.sag-kisim {
    list-style: none;
    flex: 1;
    display: flex;
    justify-content: flex-end;
    /* Kapsayıcı içindeki Hesabım linkini en sağa iter */
    gap: 10px;
    transition: color 0.2s ease;

}

.sag-kisim a:hover {
    color: #62bbff;
}

.user-nav-area {
    display: flex;
    align-items: flex-end;
    /* Sağa yaslar */
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* Giriş Yap Üye Ol*/
.top-auth-links {
    display: flex;
    align-items: center;
    gap: 8px;
    /* Kelimeler arasındaki boşluk */
    font-size: 12px;
    /* Çok küçük yazı boyutu */
}

.top-auth-links a {
    color: #002847;
    text-decoration: none;
    transition: color 0.2s ease;
}

/* Aradaki Ayraç Çizgisi (|) */
.divider {
    color: #455566;
    font-size: 11px;
}

/* Üstüne gelince renk değiştirme */
.top-auth-links a:hover {
    color: #0091ff;
}


h1 {
    vertical-align: middle;
    display: inline-block;
    font-size: xx-large;
    font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
    line-height: 1.6;
    color: var(--ana-renk);

}

nav {
    display: inline-block;
}

h4 {
    font-size: large;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--baslik-renk);

}

img {
    vertical-align: middle;
}

a {
    vertical-align: middle;
    font-size: small;
    color: var(--baglanti-renk);
    text-decoration: none;
}


footer {
    text-align: center;
    color: var(--footer-renk);
    font-size: small;

}



/* giriş yapılacak kısmın css kodları*/

table {
    border-collapse: collapse;
    width: 40%;
    margin-top: 150px;
    margin-left: auto;
    margin-right: auto;
    border-radius: 15px;
}

table td,
table th {
    padding: 15px;
    /* iki hücre arası yazı kısmı mesafesi*/
    text-align: left;
}

table input {
    width: 100%;
    /* Kutucuğu sağa doğru uzatır */
    padding: 10px;
    /* Kutucuğun kendi içini doldurur */
    border-radius: 5px;
    /* Kutucuk kenarlarını hafif yuvarlar */


}

.caption {
    text-align: center;
    font-size: xx-large;
    font-weight: bold;
    margin-bottom: 10px;
    /*tablo ile arasındaki mesafe*/
    color: rgb(255, 179, 79);
}

.buton {
    text-align: center;
    padding-top: 20px;
    /*buton ile tablo kısmı arasındaki mesafe*/
    border: none;
}

.giris-butonu {
    background-color: #faffae;
    color: #14213D;
    padding: 10px 50px;
    /*buton boyutu*/
    font-size: large;
    font-weight: bold;
    border: none;
    border-radius: 10px;
    /* Köşeleri yuvarlatır */
}

.giris-butonu:hover {
    opacity: 0.5;
    /*üzerine gelince olan saydamlık*/
}



/*üye ol kısmı*/
.signup-container {
    background-color: #1b2228;
    padding: 35px 45px;
    border-radius: 15px;
    box-shadow: 0 8px 20px rgba(70, 70, 73, 0.6);
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    width: 100%;
    max-width: 450px;
    margin: 40px auto;
}

.signup-container h2 {
    color: #ffffff;
    text-align: center;
    margin-top: 0;
    margin-bottom: 25px;
    font-size: 24px;
    letter-spacing: 0.5px;
}

/* Tablo Düzeni */
.signup-form table {
    width: 100%;
    border-collapse: collapse;
    /* Tablo kenarlık boşluklarını sıfırlar */
}

.signup-form td {
    padding: 8px 10px;
    vertical-align: middle;
}

.signup-form label {
    color: #cbd4db;
    font-weight: 500;
    font-size: 15px;
    white-space: nowrap;
    /* Metnin alt satıra kaymasını önler */
}

/* Input*/
.signup-form input[type="text"],
.signup-form input[type="date"],
.signup-form input[type="password"] {
    width: 100%;
    padding: 10px 12px;
    background-color: #2c3440;
    border: 1px solid #455566;
    border-radius: 4px;
    color: #ffffff;
    font-size: 14px;
    box-sizing: border-box;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    /* kutunun üstüne tıkladığında kenarların yeşile dönmesinin saniyesini belirler */
}

/* Girdi alanına tıklandığındaki görünüm */
.signup-form input:focus {
    outline: none;
    border-color: #00e054;
    /* Canlı yeşil vurgu */
    box-shadow: 0 0 5px rgba(0, 224, 84, 0.3);
}

/* Tarih seçici ikonu için renk ayarı (Dark mode uyumu) */
.signup-form input[type="date"]::-webkit-calendar-picker-indicator {
    filter: invert(1);
    /* tarih kutusunun yanındaki takvimin rengini tam tersine döndürmek için yazdık*/
}

/* Kullanıcı Adı Bilgi Metni */
.info-text {
    display: block;
    color: #899aa9;
    font-size: 12px;
    margin-top: 6px;
}

/* Buton Hücresi ve Buton Tasarımı */
.submit-cell {
    text-align: center;
    padding-top: 25px !important;
    /* buradaki important önceki kuralları uygulama bu kısım için demek*/
}

.submit-btn {
    background-color: #00e054;
    color: #ffffff;
    border: none;
    padding: 14px 20px;
    font-size: 16px;
    font-weight: 700;
    border-radius: 4px;
    cursor: pointer;
    /* fare üzerine geldiğinde parmak olarak gözüküyor*/
    width: 100%;
    letter-spacing: 1px;
    /*Harfler arasında 1 pixellik boşluk bırakır*/
    transition: background-color 0.3s ease;
}

.submit-btn:hover {
    background-color: #00c248;
}


/* Profil Konteyneri (Önceki tasarımla uyumlu) */
.profile-container {
    background-color: #1b2228;
    padding: 35px 45px;
    border-radius: 8px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.6);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    width: 100%;
    max-width: 450px;
    margin: 40px auto;
}

.profile-container h2 {
    color: #ffffff;
    text-align: center;
    margin-top: 0;
    margin-bottom: 25px;
    font-size: 24px;
    letter-spacing: 0.5px;
}

/* Tablo Düzeni */
.profile-form table {
    width: 100%;
    border-collapse: collapse;
}

.profile-form td {
    padding: 12px 8px;
    vertical-align: middle;
}

.profile-form label {
    color: #cbd4db;
    font-weight: 500;
    font-size: 15px;
    white-space: nowrap;
}

/* Standart Girdi Alanları */
.profile-form input[type="text"],
.profile-form input[type="date"],
.profile-form input[type="password"] {
    width: 100%;
    padding: 10px 12px;
    background-color: #2c3440;
    border: 1px solid #455566;
    border-radius: 4px;
    color: #ffffff;
    font-size: 14px;
    box-sizing: border-box;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

/* Kilitli (Değiştirilemez) Girdi Alanı Tasarımı */
.profile-form input[readonly] {
    background-color: #212830;
    /* Daha mat bir gri */
    color: #6c7a89;
    /* Soluk yazı rengi */
    cursor: not-allowed;
    /* Tıklanamaz işareti (yasak işareti) */
    border-color: #35404d;
}

.profile-form input[readonly]:focus {
    border-color: #35404d;
    /* Yeşil parlamayı engeller */
    box-shadow: none;
    outline: none;
}

/* Sadece aktif olan alanlar tıklandığında yeşil parlasın */
.profile-form input:not([readonly]):focus {
    outline: none;
    border-color: #00e054;
    box-shadow: 0 0 5px rgba(0, 224, 84, 0.3);
}

.profile-form input[type="date"]::-webkit-calendar-picker-indicator {
    filter: invert(1);
}

.info-text {
    display: block;
    color: #899aa9;
    font-size: 12px;
    margin-top: 6px;
}

/* Kaydet Butonu */
.submit-cell {
    text-align: center;
    padding-top: 25px !important;
}

.submit-btn {
    background-color: #00e054;
    color: #ffffff;
    border: none;
    padding: 14px 20px;
    font-size: 16px;
    font-weight: 700;
    border-radius: 4px;
    cursor: pointer;
    width: 100%;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: background-color 0.3s ease;
}

.submit-btn:hover {
    background-color: #00c248;
}
